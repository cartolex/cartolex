{
  "$defs": {
    "SetAside": {
      "additionalProperties": true,
      "description": "A set-aside keyword: the node it came from, why, and the attribution it had there.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "maximum": 3,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "SetAside",
      "type": "object"
    },
    "ThemeLevel": {
      "additionalProperties": true,
      "properties": {
        "names": {
          "minProperties": 1,
          "patternProperties": {
            "^[a-z]{2}$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Names",
          "type": "object"
        }
      },
      "required": [
        "names"
      ],
      "title": "ThemeLevel",
      "type": "object"
    },
    "ThemeNode": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "names": {
          "patternProperties": {
            "^[a-z]{2}$": {
              "type": "string"
            }
          },
          "title": "Names",
          "type": "object"
        },
        "order": {
          "default": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        }
      },
      "required": [
        "id"
      ],
      "title": "ThemeNode",
      "type": "object"
    },
    "ThemesBasis": {
      "additionalProperties": true,
      "properties": {
        "run": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run"
        },
        "vocabulary": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vocabulary"
        }
      },
      "title": "ThemesBasis",
      "type": "object"
    },
    "ThemesSaved": {
      "additionalProperties": true,
      "description": "When a version of the tree was saved, and the action that saved it.",
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        }
      },
      "required": [
        "at",
        "action"
      ],
      "title": "ThemesSaved",
      "type": "object"
    }
  },
  "$id": "https://cartolex.github.io/schemas/1/themes.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "``decisions/themes.json``: the theme tree, 1 to 4 levels of nodes holding keywords.\n\nA keyword is under one node, at any level (a keyword on a higher node is\nbroader than every node below it), or set aside. Its usage counts toward its\nnode and every node above it; ``attribution`` lowers that to levels 1 to\n``n`` (``0``: nowhere), with ``n`` below its node's level.",
  "properties": {
    "attribution": {
      "additionalProperties": {
        "maximum": 3,
        "minimum": 0,
        "type": "integer"
      },
      "title": "Attribution",
      "type": "object"
    },
    "based_on": {
      "$ref": "#/$defs/ThemesBasis"
    },
    "depth": {
      "maximum": 4,
      "minimum": 1,
      "title": "Depth",
      "type": "integer"
    },
    "format": {
      "const": "cartolex-themes/1",
      "default": "cartolex-themes/1",
      "title": "Format",
      "type": "string"
    },
    "keywords": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "object"
    },
    "levels": {
      "items": {
        "$ref": "#/$defs/ThemeLevel"
      },
      "title": "Levels",
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/ThemeNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "review": {
      "additionalProperties": {
        "enum": [
          "to_check",
          "reviewed"
        ],
        "type": "string"
      },
      "title": "Review",
      "type": "object"
    },
    "saved": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThemesSaved"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "set_aside": {
      "additionalProperties": {
        "$ref": "#/$defs/SetAside"
      },
      "title": "Set Aside",
      "type": "object"
    }
  },
  "required": [
    "depth",
    "levels"
  ],
  "title": "ThemesFile",
  "type": "object"
}
