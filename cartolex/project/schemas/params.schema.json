{
  "$id": "https://cartolex.github.io/schemas/1/params.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "``decisions/params.json``: the parameters people set, and nothing else.\n\n``collect`` (optional) holds the collection's parameters people set, by step\n(:data:`COLLECT_PARAMS`); ``ai`` (optional) the route chosen for each AI step\n(:data:`AI_ROUTES`). Both are left out of the file when empty.",
  "properties": {
    "ai": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Ai",
      "type": "object"
    },
    "collect": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Collect",
      "type": "object"
    },
    "format": {
      "const": "cartolex-params/1",
      "default": "cartolex-params/1",
      "title": "Format",
      "type": "string"
    },
    "pinned_year": {
      "anyOf": [
        {
          "maximum": 2200,
          "minimum": 1900,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pinned Year"
    },
    "seed": {
      "default": 0,
      "exclusiveMaximum": 4294967296,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "stages": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Stages",
      "type": "object"
    }
  },
  "title": "ParamsFile",
  "type": "object"
}
