{
  "format": "cartolex-manifest/1",
  "app": {
    "id": "cartolex",
    "name": "cartolex",
    "version": "1.0.0.dev0"
  },
  "branding": {
    "name": "cartolex",
    "logo": "/static/brand/logo.svg"
  },
  "locales": {
    "available": [
      "en",
      "fr",
      "pt-BR"
    ],
    "default": "en",
    "catalogues": {
      "en": [
        "/static/i18n/en.json",
        "/static/ext/demo/i18n/en.json"
      ],
      "fr": [
        "/static/i18n/fr.json",
        "/static/ext/demo/i18n/fr.json"
      ],
      "pt-BR": [
        "/static/i18n/pt-BR.json",
        "/static/ext/demo/i18n/pt-BR.json"
      ]
    }
  },
  "nav": [
    {
      "id": "overview",
      "label": "nav.overview",
      "route": "/overview",
      "module": "/static/pages/overview.js",
      "order": 10,
      "placement": "main"
    },
    {
      "id": "build",
      "label": "nav.build",
      "route": "/build",
      "module": "/static/pages/build.js",
      "order": 15,
      "placement": "hidden"
    },
    {
      "id": "people",
      "label": "nav.people",
      "route": "/people",
      "module": "/static/pages/people.js",
      "order": 20,
      "placement": "main"
    },
    {
      "id": "keywords",
      "label": "nav.keywords",
      "route": "/keywords",
      "module": "/static/pages/keywords.js",
      "order": 30,
      "placement": "main"
    },
    {
      "id": "themes",
      "label": "nav.themes",
      "route": "/themes",
      "module": "/static/pages/themes.js",
      "order": 40,
      "placement": "main"
    },
    {
      "id": "map",
      "label": "nav.map",
      "route": "/map",
      "module": "/static/pages/map.js",
      "order": 50,
      "placement": "main"
    },
    {
      "id": "share",
      "label": "nav.share",
      "route": "/share",
      "module": "/static/pages/share.js",
      "order": 60,
      "placement": "main"
    },
    {
      "id": "settings",
      "label": "nav.settings",
      "route": "/settings",
      "module": "/static/pages/settings.js",
      "order": 90,
      "placement": "settings"
    }
  ],
  "modules": [
    "/static/ext/demo/index.js"
  ],
  "capabilities": {
    "collection": true,
    "ai_api": false,
    "ai_copilot": true,
    "hosted": false,
    "idle_stop": false
  },
  "project": {
    "open": true,
    "id": "demo-coast",
    "name": "Coastal and marine demo"
  },
  "security": {
    "csrf_header": "X-Cartolex-CSRF",
    "csrf_cookie": "cartolex_csrf"
  }
}
