{
  "$id": "https://cartolex.github.io/schemas/1/stopwords.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "``decisions/stopwords.json``: additions to and removals from the function-word lists.",
  "properties": {
    "add": {
      "patternProperties": {
        "^[a-z]{2}$": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Add",
      "type": "object"
    },
    "format": {
      "const": "cartolex-stopwords/1",
      "default": "cartolex-stopwords/1",
      "title": "Format",
      "type": "string"
    },
    "remove": {
      "patternProperties": {
        "^[a-z]{2}$": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Remove",
      "type": "object"
    }
  },
  "title": "StopwordsFile",
  "type": "object"
}
